rategy":"onPageLoad","batchGroup":null,"seeAllAction":{"title":"Version History","presentationStyle":[],"actionMetrics":{"$kind":"ActionMetrics","data":[{"shouldFlush":false,"fields":{"location":[{"locationPosition":0,"locationType":"button","name":"Version History","idType":"its_id","id":"See All"}],"actionType":"navigate","target":"button_See All","eventType":"click","targetType":"button","targetId":"See All","platformContext":"iphone","alt_ab2_data":"[]"},"includingFields":["impressionsSnapshot","pageFields","contentRestrictionReasons"],"excludingFields":["amsMetricsID"],"topic":"xp_amp_appstore_unidentified"}],"custom":{}},"$kind":"flowAction","actionClass":"FlowAction","page":"versionHistory","pageData":{"shelves":[{"$kind":"Shelf","impressionMetrics":null,"contentType":"titledParagraph","marker":null,"items":[{"$kind":"TitledParagraph","text":"Performance and app stability have been improved for a better user experience.","style":"detail","wantsCollapsedNewlines":true,"primarySubtitle":"1.19.8","secondarySubtitle":"Wed Oct 21 2026 15:50:35 GMT+0000 (Coordinated Universal Time)"},{"$kind":"TitledParagraph","text":"Proactive Assistant suggestions have been added to the homepage.\nA contact forms page has been added to the menus.\nSupport for order filters—configured via the T-Soft panel—has been implemented within the application.\nAccount login processes have been improved.\nSession persistence (keeping the user logged in) has been improved.\nThe order printing function has been improved.\nGeneral performance and security enhancements have been made.","style":"detail","wantsCollapsedNewlines":true,"primarySubtitle":"1.19.5","secondarySubtitle":"Thu Oct 15 2026 22:11:03 GMT+0000 (Coordinated Universal Time)"},{"$kind":"TitledParagraph","text":"General version improvements have been made.","style":"detail","wantsCollapsedNewlines":true,"primarySubtitle":"1.18.12","secondarySubtitle":"Fri Oct 09 2026 16:36:11 GMT+0000 (Coordinated Universal Time)"},{"$kind":"TitledParagraph","text":"Long-press functionality has been added to the order list and the device home screen.\nPerformance improvements have been made.","style":"detail","wantsCollapsedNewlines":true,"primarySubtitle":"1.18.11","secondarySubtitle":"Fri Oct 09 2026 00:54:15 GMT+0000 (Coordinated Universal Time)"},{"$kind":"TitledParagraph","text":"T-Soft 360 has been completely redesigned!\n\nNew design: Every screen now has a cleaner, more modern interface that's easier to use.\nRedesigned home screen: Your sales chart for the last 7 days, order count and average basket value are right there when you open the app. Switch between Today, 7 days and 30 days with a single tap.\nOrder status overview: Follow orders that are ready to ship, being prepared or shipped, all from the home screen.\nSmarter order list: Use quick search, sorting and status tabs to find any order in seconds. Integration warnings now show up directly in the list.\nAdvanced filters: Filter orders by date range, status and amount.\nRedesigned product management: Sort your products into active, inactive, low stock and out of stock. Add physical or digital products with ease.\nBarcode scanner: Scan barcodes with your camera to get to products and orders fast.\nEasy store switching: If you run more than one store, switch between them with one tap or add a new one.","style":"detail","wantsCollapsedNewlines":true,"primarySubtitle":"1.18.7","secondarySubtitle":"Tue Oct 06 2026 18:45:51 GMT+0000 (Coordinated Universal Time)"},{"$kind":"TitledParagraph","text":"The Home screen has been redesigned to provide a more modern and user-friendly experience.\nShipping information can now be entered while updating orders to the Ready for Shipment and Shipped statuses.\nBulk update support has been added for Shipped, Order Transferred, and Packaging statuses, making order management faster and more efficient.","style":"detail","wantsCollapsedNewlines":true,"primarySubtitle":"1.17.5","secondarySubtitle":"Tue Sep 22 2026 16:33:32 GMT+0000 (Coordinated Universal Time)"},{"$kind":"TitledParagraph","text":"New information fields have been added to the Dashboard.\nYou can now monitor live visitors in real time directly from the Dashboard.\nMulti-category support has been added. You can now assign products to multiple categories when creating or updating them.","style":"detail","wantsCollapsedNewlines":true,"primarySubtitle":"1.16.3","secondarySubtitle":"Thu Sep 10 2026 03:27:05 GMT+0000 (Coordinated Universal Time)"},{"$kind":"TitledParagraph","text":"The display of product quantities on the orders page has been improved.","style":"detail","wantsCollapsedNewlines":true,"primarySubtitle":"1.15.2","secondarySubtitle":"Fri Aug 28 2026 18:04:42 GMT+0000 (Coordinated Universal Time)"},{"$kind":"TitledParagraph","text":"Member activation/deactivation feature added. \n\"Digital product\" option added when adding new products. \nGeneral performance improvements have been made.","style":"detail","wantsCollapsedNewlines":true,"primarySubtitle":"1.14.5","secondarySubtitle":"Thu Aug 27 2026 19:34:57 GMT+0000 (Coordinated Universal Time)"},{"$kind":"TitledParagraph","text":"A feature for adding product descriptions via Nova has been introduced.\nThe Themes page has been updated, and a \"Theme Management\" menu has been added to the \"More\" screen.\n\nYou can now quickly update product descriptions with the help of AI and easily manage themes via the mobile app.","style":"detail","wantsCollapsedNewlines":true,"primarySubtitle":"1.14.3","secondarySubtitle":"Fri Aug 21 2026 22:41:50 GMT+0000 (Coordinated Universal Time)"},{"$kind":"TitledParagraph","text":"\"Publishing\" settings have been added to the product information editing page.","style":"detail","wantsCollapsedNewlines":true,"primarySubtitle":"1.13.3","secondarySubtitle":"Fri Aug 14 2026 17:33:03 GMT+0000 (Coordinated Universal Time)"},{"$kind":"TitledParagraph","text":"Camera support has been added to the barcode field.\nSupport for sub-products has been added to image uploads.\nSupport for virtual models has been added with Nova Studio.","style":"detail","wantsCollapsedNewlines":true,"primarySubtitle":"1.13.2","secondarySubtitle":"Fri Jul 31 2026 18:26:32 GMT+0000 (Coordinated Universal Time)"},{"$kind":"TitledParagraph","text":"A feature for creating product images using Nova Studio has been added.","style":"detail","wantsCollapsedNewlines":true,"primarySubtitle":"1.12.2","secondarySubtitle":"Fri Jul 17 2026 18:51:48 GMT+0000 (Coordinated Universal Time)"},{"$kind":"TitledParagraph","text":"Markdown support has been added to the product description field on the product editing screen.\nImprovements have been made to the user interface.\nGeneral release and performance improvements have been made.","style":"detail","wantsCollapsedNewlines":true,"primarySubtitle":"1.12.1","secondarySubtitle":"Thu Jul 02 2026 22:24:05 GMT+0000 (Coordinated Universal Time)"},{"$kind":"TitledParagraph","text":"General version improvements have been made.","style":"detail","wantsCollapsedNewlines":true,"primarySubtitle":"1.11.2","secondarySubtitle":"Tue Jun 16 2026 17:58:20 GMT+0000 (Coordinated Universal Time)"},{"$kind":"TitledParagraph","text":"An extra print order button has been added to the top right corner of the order details page.\nA \"Log in with T-Soft 360\" button has been added. \nGeneral version improvements have been made.","style":"detail","wantsCollapsedNewlines":true,"primarySubtitle":"1.10.3","secondarySubtitle":"Thu Jun 04 2026 22:53:09 GMT+0000 (Coordinated Universal Time)"},{"$kind":"TitledParagraph","text":"General versions have been made.","style":"detail","wantsCollapsedNewlines":true,"primarySubtitle":"1.10.1","secondarySubtitle":"Wed May 20 2026 23:19:33 GMT+0000 (Coordinated Universal Time)"},{"$kind":"TitledParagraph","text":"General improvements have been made.","style":"detail","wantsCollapsedNewlines":true,"primarySubtitle":"1.9.3","secondarySubtitle":"Thu May 07 2026 18:56:14 GMT+0000 (Coordinated Universal Time)"},{"$kind":"TitledParagraph","text":"Order printing feature added. You can quickly print your orders from the order detail page.\nDiscounted price management feature added. You can easily manage discounts from the product edit screen.\nPurchase price entry feature added. You can now track product costs within the app.","style":"detail","wantsCollapsedNewlines":true,"primarySubtitle":"1.9.2","secondarySubtitle":"Fri May 01 2026 13:19:28 GMT+0000 (Coordinated Universal Time)"},{"$kind":"TitledParagraph","text":"• Wallet feature added\nYou can now quickly access your wallet and easily manage your transactions.\n\n• AI-Powered Member Search\nWith the new AI-powered search feature on the Member List page, you can find the members you’re looking for much faster and more easily.","style":"detail","wantsCollapsedNewlines":true,"primarySubtitle":"1.8.2","secondarySubtitle":"Tue Apr 21 2026 20:35:17 GMT+0000 (Coordinated Universal Time)"},{"$kind":"TitledParagraph","text":"Apple Watch feature added.","style":"detail","wantsCollapsedNewlines":true,"primarySubtitle":"1.8.1","secondarySubtitle":"Tue Apr 14 2026 18:11:08 GMT+0000 (Coordinated Universal Time)"},{"$kind":"TitledParagraph","text":"A feature to modify the order process has been added to the Order List page.","style":"detail","wantsCollapsedNewlines":true,"primarySubtitle":"1.7.4","secondarySubtitle":"Fri Apr 10 2026 17:03:23 GMT+0000 (Coordinated Universal Time)"},{"$kind":"TitledParagraph","text":"Nova AI is now available.","style":"detail","wantsCollapsedNewlines":true,"primarySubtitle":"1.7.3","secondarySubtitle":"Fri Apr 10 2026 02:14:53 GMT+0000 (Coordinated Universal Time)"},{"$kind":"TitledParagraph","text":"A microphone-based search feature has been added to the products page. \nWe have added support for displaying sub-product information on the order details page. \nGeneral performance improvements have been made.","style":"detail","wantsCollapsedNewlines":true,"primarySubtitle":"1.7.2",