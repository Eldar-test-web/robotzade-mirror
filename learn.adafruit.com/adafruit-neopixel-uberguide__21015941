        <a href="./elements/2894435/assets/30750/exhibit">
            <img class='30750-asset small-side-image' src='../cdn-learn.adafruit.com/assets/assets/000/030/750/medium640/leds_shields__0f72dd6b.jpg' alt='leds_shields.jpg' loading='lazy' />
