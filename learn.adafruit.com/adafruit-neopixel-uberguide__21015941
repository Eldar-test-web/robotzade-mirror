            <h2>
              <span id="wwa-white-pixels">WWA White Pixels</span>
            </h2>

            <section class="page-content">
                <div class="" role="region" aria-label="Page content">
        <figure class="element image-element">
    <a href="./assets/144903">
        <video preload="auto" muted="muted" loop="loop" playsinline poster="../cdn-learn.adafruit.com/assets/assets/000/144/903/medium800thumb/leds_6509-03_1__32844d38.jpg" aria-label="">
