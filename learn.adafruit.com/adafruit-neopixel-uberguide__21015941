</a>      </div>
      <div class="small-side">
        <a href="./elements/2894435/assets/30717/exhibit">
            <img class='30717-asset small-side-image' src='../cdn-learn.adafruit.com/assets/assets/000/030/717/medium640/leds_shield2__022ab5cf.jpg' alt='leds_shield2.jpg' loading='lazy' />
