    <link rel="alternate" type="text/html" href="https://learn.adafruit.com/meshfruit-message-board"/>
    <url>https://learn.adafruit.com/meshfruit-message-board</url>
    <title>MeshFruit Message Board</title>
    <content type="html">&lt;p&gt;MeshFruit Message Board&lt;/p&gt;&lt;p&gt;&lt;a href='https://learn.adafruit.com/meshfruit-message-board'&gt;&lt;img src='https://cdn-learn.adafruit.com/guides/images/000/004/624/medium500/hero-fridge-right.jpg?1789929321' /&gt;&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Build an off-grid message board! This message board listens for messages sent across a LoRa network and shows them on an e-ink display.&lt;br/&gt;&lt;br/&gt;&lt;a href='https://learn.adafruit.com/meshfruit-message-board'&gt;Learn More&lt;/a&gt;&lt;/p&gt;</content>
    <updated>2026-09-22T23:05:00Z</updated>
